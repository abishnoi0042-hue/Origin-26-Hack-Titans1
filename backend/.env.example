# AeroHealth AI Configuration

# Port settings
PORT=8000
HOST=0.0.0.0

# Free AI LLM API Keys (Optional - Rule-based fallback works automatically if omitted)
# Google Gemini API key: Get from https://aistudio.google.com/
GEMINI_API_KEY=

# Or Groq API key: Get free from https://console.groq.com/
GROQ_API_KEY=

# OpenWeather API Key (Optional - Real Open-Meteo & OpenStreetMap work out-of-the-box)
# Get free from https://openweathermap.org/api
OPENWEATHER_API_KEY=
